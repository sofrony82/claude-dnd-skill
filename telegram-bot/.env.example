# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Restrict access to these Telegram user IDs (comma separated). Empty = anyone.
TELEGRAM_ALLOWED_USERS=

# Which prepared module pack to run
DND_MODULE=stormwreck-isle

# DM model and reasoning effort
DND_MODEL=claude-opus-5
DND_EFFORT=medium

# ── Backend ──────────────────────────────────────────────────────────────
# claude   — Claude Agent SDK (needs claude-agent-sdk + the Claude CLI)
# deepseek — DeepSeek on Nebius Token Factory (needs openai)
DND_BACKEND=deepseek

# Nebius Token Factory key for the DeepSeek backend.
NB_STUDIO_API_KEY=
NB_BASE_URL=https://api.tokenfactory.nebius.com/v1
DND_DS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Warmth of the prose (0.8 default), reply cap, tool calls per turn,
# and how many player turns stay verbatim in the context window.
DND_DS_TEMPERATURE=0.8
DND_DS_MAX_TOKENS=3000
DND_DS_MAX_STEPS=24
DND_HISTORY_TURNS=12
